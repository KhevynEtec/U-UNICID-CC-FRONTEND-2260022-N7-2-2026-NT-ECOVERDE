# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# Porta local do servidor (o Railway define a sua automaticamente)
PORT=3000

# Tokens usados pelos servidores MCP no Cursor (opcionais)
# GitHub: Settings > Developer settings > Personal access tokens (permissões mínimas)
GITHUB_PAT=
# Figma: Settings > Security > Personal access tokens
FIGMA_API_KEY=
